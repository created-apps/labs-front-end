# Public site address (used for canonical URLs, sitemap and social images)
NEXT_PUBLIC_SITE_URL=https://labs.create-ed.in

# Sanity (from sanity.io/manage). Leave the project ID empty to run on the bundled launch content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Server-only secrets — never prefix these with NEXT_PUBLIC_
SANITY_API_READ_TOKEN=          # Viewer token, used only for draft preview
SANITY_REVALIDATE_SECRET=       # any long random string; also entered in the Sanity webhook

# Optional fallback if GA4 isn't set in Site settings
NEXT_PUBLIC_GA_ID=

# Only for scripts/generate-textures.mjs (one-off). Not used by the website.
GEMINI_API_KEY=

# Supabase (brochure lead capture). Project settings > API in the Supabase dashboard.
# The app writes to exactly one table: brochure_leads (a single INSERT) — see supabase/brochure_leads.sql.
SUPABASE_URL=
# Server-only — never prefix with NEXT_PUBLIC_. This key bypasses RLS, so the
# "only brochure_leads" guarantee rests on application code alone.
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback, used only if SUPABASE_SERVICE_ROLE_KEY is unset.
# SUPABASE_ANON_KEY=
